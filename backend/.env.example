# Server Configuration
PORT=4000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
SANDBOX_ORIGIN=http://localhost:3001

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=game_platform_lms

# Security Keys & Peppers
# Important: PEPPER must be a strong 32+ character random secret
SERVER_PEPPER=change_this_to_a_very_strong_random_secret_string_32_chars
SESSION_COOKIE_NAME=__Host-sid
DEVICE_COOKIE_NAME=__Host-device_id
COOKIE_SECRET=change_this_cookie_secret_key_random_32_chars
COOKIE_SECURE=false # Set to true in production (HTTPS)
